# Copia este archivo como .env y llena los valores. .env nunca se sube al repositorio.

# Servidor
PUERTO=3000
NODE_ENV=development

# Origen del front (Vite) autorizado para enviar cookies a la API
ORIGEN_FRONT=http://127.0.0.1:5173

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=sigb_ducky
PGUSER=postgres
PGPASSWORD=cambia_esta_contrasena

# Sesiones: clave secreta para firmar las sesiones (mínimo 32 caracteres, distinta en cada equipo).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambia_esta_clave_por_una_aleatoria_de_al_menos_32_caracteres
DURACION_SESION_HORAS=8

# Intentos de inicio de sesión permitidos por IP en la ventana indicada
LIMITE_INTENTOS_LOGIN=10
VENTANA_INTENTOS_MINUTOS=15

# Asistente Ducky (opcional): usuario de PostgreSQL de SOLO LECTURA con el que el asistente
# consulta el catálogo. Lo crean "npm run db:reset" y "npm run db:migrar" con estos valores.
# Debe ser distinto de PGUSER. Sin estas dos líneas la aplicación funciona igual.
CHAT_PGUSER=sigb_chat_lectura
CHAT_PGPASSWORD=cambia_esta_contrasena_de_solo_lectura

# Asistente Ducky (opcional): modelo Gemini por Gemini Enterprise Agent Platform de Google Cloud.
# La key es de Agent Platform (consola de Google Cloud), NO de Google AI Studio. Solo la usa el
# backend: nunca la renombres con el prefijo VITE_ ni la subas al repositorio.
# Sin key, o con CHAT_HABILITADO=false, el asistente queda apagado y lo demás funciona igual.
# Comprueba la conexión con: npm run chat:probar
CHAT_HABILITADO=true
GEMINI_API_KEY=pega_aqui_tu_key_de_agent_platform
GEMINI_MODELO=gemini-3.5-flash-lite

# Límites del asistente para controlar el gasto: preguntas por cuenta en cada minuto y largo
# máximo de una pregunta
CHAT_LIMITE_POR_MINUTO=6
CHAT_MAX_CARACTERES=500
