{
  "name": "biblioteca-ducky",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "inicio": "concurrently -n api,front -c blue,green \"npm run api\" \"npm run dev\"",
    "api": "nodemon servidor.js",
    "api:start": "node servidor.js",
    "db:reset": "node db/reiniciarBaseDatos.js",
    "test": "node --test tests/*.test.mjs",
    "test:bd": "node --test --test-concurrency=1 --test-timeout=30000 tests/integracion/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run lint && npm run format:check && npm test"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "servidor.js",
      "config",
      "controladores",
      "middlewares",
      "modelos",
      "rutas",
      "servicios",
      "utilidades",
      "vistas",
      ".env"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
